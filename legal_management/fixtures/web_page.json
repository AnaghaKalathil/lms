  "main_section_html": "<style>\n.hero {\n  background: linear-gradient(120deg, #1e3c72, #2a5298);\n  color: white;\n  padding: 60px 20px;\n  text-align: center;\n}\n\n.hero h1 {\n  font-size: 36px;\n  margin-bottom: 10px;\n}\n\n.hero p {\n  font-size: 18px;\n  opacity: 0.9;\n}\n\n.search-card {\n  max-width: 700px;\n  margin: -40px auto 40px;\n  background: white;\n  padding: 30px;\n  border-radius: 12px;\n  box-shadow: 0 10px 25px rgba(0,0,0,0.1);\n}\n\n.btn-search {\n  background: #1e3c72;\n  color: white;\n  border: none;\n}\n\n.case-card {\n  max-width: 900px;\n  margin: auto;\n  background: white;\n  padding: 25px;\n  border-radius: 10px;\n  box-shadow: 0 5px 15px rgba(0,0,0,0.08);\n}\n\n.badge-status {\n  padding: 5px 10px;\n  border-radius: 6px;\n  font-size: 12px;\n}\n\n.badge-Active {\n  background: #28a745;\n  color: white;\n}\n\n.badge-Inactive {\n  background: #6c757d;\n  color: white;\n}\n\n.table th {\n  background: #f4f6f8;\n}\n</style>\n\n<!-- HERO / BANNER -->\n<div class=\"hero\">\n  <h1>Legal Management System</h1>\n  <p>Track case details and hearings securely</p>\n</div>\n\n<!-- SEARCH CARD -->\n<div class=\"search-card\">\n  <h4 class=\"text-center\">Search Your Case</h4>\n  <input type=\"text\" id=\"case_title\" class=\"form-control mt-3\"\n         placeholder=\"Enter Case Title\">\n  <button class=\"btn btn-search btn-block mt-3\" onclick=\"searchCase()\">\n    Search Case\n  </button>\n</div>\n\n<!-- RESULT -->\n<div id=\"result\"></div>\n\n<script>\nfunction searchCase() {\n  const title = document.getElementById(\"case_title\").value.trim();\n  const result = document.getElementById(\"result\");\n\n  if (!title) {\n    alert(\"Please enter case title\");\n    return;\n  }\n\n  result.innerHTML = \"<p class='text-center'>Searching...</p>\";\n\n  frappe.call({\n    method: \"legal_management.api.get_case_details\",\n    args: { case_title: title },\n    callback: function(r) {\n      if (!r.message) {\n        result.innerHTML =\n          \"<p class='text-center text-danger'>No case found</p>\";\n        return;\n      }\n\n      const c = r.message.case;\n      const hearings = r.message.hearings;\n\n      let html = `\n        <div class=\"case-card\">\n          <h4>${c.case_title}</h4>\n          <p>\n            <b>Case Type:</b> ${c.case_type}<br>\n            <b>Client:</b> ${c.client}<br>\n            <b>Assigned Lawyer:</b> ${c.assigned_lawyer || \"-\"}<br>\n            <b>Status:</b>\n            <span class=\"badge-status badge-${c.status}\">\n              ${c.status}\n            </span>\n          </p>\n\n          <hr>\n          <h5>Hearing Schedule</h5>\n      `;\n\n      if (hearings.length) {\n        html += `\n          <table class=\"table table-bordered\">\n            <thead>\n              <tr>\n                <th>Date</th>\n                <th>Court</th>\n                <th>Purpose</th>\n              </tr>\n            </thead>\n            <tbody>\n        `;\n\n        hearings.forEach(h => {\n          html += `\n            <tr>\n              <td>${h.hearing_date}</td>\n              <td>${h.court}</td>\n              <td>${h.purpose}</td>\n            </tr>\n          `;\n        });\n\n        html += `</tbody></table>`;\n      } else {\n        html += \"<p>No hearings scheduled.</p>\";\n      }\n\n      html += \"</div>\";\n      result.innerHTML = html;\n    }\n  });\n}\n</script>\n",
