  "main_section_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Live MJML Editor</title>\n<style>\n  body {\n    font-family: Arial, sans-serif;\n    margin: 0;\n    display: flex;\n    flex-direction: column;\n    min-height: 100vh;\n    background: #f4f4f9;\n  }\n  header, footer {\n    background: #4a90e2;\n    color: #fff;\n    padding: 20px;\n    text-align: center;\n  }\n  main {\n    flex: 1;\n    display: flex;\n    gap: 20px;\n    padding: 20px;\n  }\n  .editor, .preview, .mjml-code {\n    flex: 1;\n    border-radius: 8px;\n    padding: 15px;\n    background: #fff;\n    box-shadow: 0 2px 8px rgba(0,0,0,0.1);\n    overflow: auto;\n  }\n  .editor textarea {\n    width: 100%;\n    height: 400px;\n    border: none;\n    resize: none;\n    font-size: 16px;\n    font-family: monospace;\n  }\n  .preview h2 {\n    color: #4a90e2;\n  }\n  .mjml-code pre {\n    font-family: monospace;\n    font-size: 14px;\n    white-space: pre-wrap;\n    word-wrap: break-word;\n  }\n</style>\n</head>\n<body>\n\n<header>\n  <h1>Dynamic MJML Editor</h1>\n</header>\n\n<main>\n  <!-- Editor -->\n  <div class=\"editor\">\n    <h3>Content Editor</h3>\n    <textarea id=\"editor\" placeholder=\"Type your content here...\">Welcome to our dynamic MJML editor!</textarea>\n  </div>\n\n  <!-- Live Preview -->\n  <div class=\"preview\" id=\"preview\">\n    <h2>Live Preview</h2>\n    <p>Welcome to our dynamic MJML editor!</p>\n  </div>\n\n  <!-- MJML Code -->\n  <div class=\"mjml-code\">\n    <h3>Generated MJML</h3>\n    <pre id=\"mjml-output\">\n<mjml>\n  <mj-body>\n    <mj-section>\n      <mj-column>\n        <mj-text>Welcome to our dynamic MJML editor!</mj-text>\n      </mj-column>\n    </mj-section>\n  </mj-body>\n</mjml>\n    </pre>\n  </div>\n</main>\n\n<footer>\n  <p>Dynamic MJML Editor © 2026</p>\n</footer>\n\n<script>\nconst editor = document.getElementById('editor');\nconst preview = document.getElementById('preview');\nconst mjmlOutput = document.getElementById('mjml-output');\n\nfunction updateContent() {\n  const content = editor.value.replace(/\\n/g, '<br>');\n\n  // Update Live Preview\n  preview.innerHTML = `<h2>Live Preview</h2><p>${content}</p>`;\n\n  // Update MJML\n  const mjml = `<mjml>\n  <mj-body>\n    <mj-section>\n      <mj-column>\n        <mj-text>${editor.value}</mj-text>\n      </mj-column>\n    </mj-section>\n  </mj-body>\n</mjml>`;\n  \n  mjmlOutput.textContent = mjml;\n}\n\n// Initial update\nupdateContent();\n\n// Listen for input changes\neditor.addEventListener('input', updateContent);\n</script>\n\n</body>\n</html>\n",
