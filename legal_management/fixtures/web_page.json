  "main_section_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>MJML Campaign Builder</title>\n<style>\n/* RESET */\n* { box-sizing: border-box; }\n\nhtml, body {\n  margin: 0;\n  padding: 0;\n  height: 100%;\n  width: 100%;\n  font-family: Inter, Arial, sans-serif;\n  background: #f4f6fb;\n}\n\n/* ROOT LAYOUT */\n.app {\n  display: flex;\n  flex-direction: column;\n  height: 100vh;\n  width: 100vw;\n}\n\n/* HEADER */\n.header {\n  height: 56px;\n  background: #4a90e2;\n  color: #fff;\n  display: flex;\n  align-items: center;\n  padding: 0 20px;\n  font-size: 18px;\n  font-weight: 600;\n}\n\n/* MAIN */\n.main {\n  flex: 1;\n  display: flex;\n  overflow: hidden;\n}\n\n/* LEFT SIDEBAR */\n.sidebar {\n  width: 260px;\n  background: #ffffff;\n  border-right: 1px solid #ddd;\n  padding: 14px;\n  overflow-y: auto;\n}\n\n.sidebar h4 {\n  margin-top: 0;\n  margin-bottom: 10px;\n}\n\n.tool {\n  background: #eef1f7;\n  padding: 10px;\n  margin-bottom: 10px;\n  border-radius: 6px;\n  text-align: center;\n  cursor: grab;\n  font-weight: 500;\n}\n\n/* CANVAS */\n.canvas-wrapper {\n  flex: 1;\n  background: #eef1f7;\n  padding: 20px;\n  overflow-y: auto;\n}\n\n.canvas {\n  max-width: 900px;\n  margin: 0 auto;\n  background: #ffffff;\n  padding: 24px;\n  border-radius: 8px;\n  min-height: 100%;\n}\n\n/* SECTION / COLUMN */\n.section {\n  border: 2px dashed #ccc;\n  padding: 14px;\n  margin-bottom: 20px;\n}\n\n.columns {\n  display: flex;\n  gap: 12px;\n}\n\n.column {\n  flex: 1;\n  min-height: 120px;\n  border: 1px dashed #aaa;\n  padding: 10px;\n  background: #fafafa;\n}\n\n/* BLOCKS */\n.block {\n  background: #ffffff;\n  border: 1px solid #ddd;\n  border-radius: 4px;\n  padding: 8px;\n  margin-bottom: 8px;\n  position: relative;\n}\n\n.block [contenteditable]:focus {\n  outline: 2px solid #4a90e2;\n}\n\n/* DELETE BUTTON */\n.delete-btn {\n  position: absolute;\n  top: 4px;\n  right: 4px;\n  border: none;\n  background: #ff4d4f;\n  color: white;\n  font-size: 12px;\n  padding: 2px 6px;\n  border-radius: 4px;\n  cursor: pointer;\n}\n\n/* IMAGE */\n.block img {\n  max-width: 100%;\n  display: block;\n  margin-top: 6px;\n}\n\n.image-controls {\n  font-size: 12px;\n  margin-top: 6px;\n}\n\n/* RIGHT PANEL */\n.right-panel {\n  width: 420px;\n  background: #ffffff;\n  border-left: 1px solid #ddd;\n  padding: 14px;\n  overflow-y: auto;\n}\n\n.right-panel h4 {\n  margin-top: 0;\n}\n\npre {\n  background: #f6f6f6;\n  padding: 10px;\n  border-radius: 6px;\n  font-size: 12px;\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n</style>\n</head>\n<body>\n\n<div class=\"app\">\n\n  <!-- HEADER -->\n  <div class=\"header\">MJML Campaign Builder</div>\n\n  <!-- MAIN -->\n  <div class=\"main\">\n\n    <!-- LEFT SIDEBAR -->\n    <div class=\"sidebar\">\n      <h4>Layout</h4>\n      <div class=\"tool\" draggable=\"true\" data-type=\"1col\">1 Column</div>\n      <div class=\"tool\" draggable=\"true\" data-type=\"2col\">2 Columns</div>\n      <div class=\"tool\" draggable=\"true\" data-type=\"3col\">3 Columns</div>\n      <hr>\n      <h4>Blocks</h4>\n      <div class=\"tool\" draggable=\"true\" data-type=\"text\">Text</div>\n      <div class=\"tool\" draggable=\"true\" data-type=\"image\">Image</div>\n      <button id=\"save-template-btn\" style=\"margin-top:10px;padding:8px 12px;background:#4a90e2;color:#fff;border:none;border-radius:4px;cursor:pointer;\">\n        Save as Email Template\n      </button>\n    </div>\n\n    <!-- CENTER CANVAS -->\n    <div class=\"canvas-wrapper\">\n      <div class=\"canvas\" id=\"canvas\">\n        <!-- Sections go here -->\n      </div>\n    </div>\n\n    <!-- RIGHT PANEL -->\n    <div class=\"right-panel\">\n      <h4>Generated MJML</h4>\n      <pre id=\"mjmlOutput\"></pre>\n    </div>\n\n  </div>\n</div>\n\n<script>\nconst canvas = document.getElementById(\"canvas\");\nconst mjmlOut = document.getElementById(\"mjmlOutput\");\n\n/* ===============================\n   DRAG SOURCES\n=============================== */\ndocument.querySelectorAll(\".tool\").forEach(tool => {\n  tool.addEventListener(\"dragstart\", e => {\n    e.dataTransfer.setData(\"text/plain\", tool.dataset.type);\n  });\n});\n\n/* ===============================\n   CANVAS DROP (SECTIONS)\n=============================== */\ncanvas.addEventListener(\"dragover\", e => e.preventDefault());\ncanvas.addEventListener(\"drop\", e => {\n  e.preventDefault();\n  const type = e.dataTransfer.getData(\"text/plain\");\n  if (type.endsWith(\"col\")) {\n    addSection(parseInt(type[0]));\n  }\n});\n\n/* ===============================\n   SECTION\n=============================== */\nfunction addSection(colCount) {\n  const section = document.createElement(\"div\");\n  section.className = \"section\";\n\n  const columns = document.createElement(\"div\");\n  columns.className = \"columns\";\n\n  for (let i = 0; i < colCount; i++) {\n    const col = document.createElement(\"div\");\n    col.className = \"column\";\n\n    col.addEventListener(\"dragover\", e => e.preventDefault());\n    col.addEventListener(\"drop\", e => {\n      e.preventDefault();\n      const type = e.dataTransfer.getData(\"text/plain\");\n      if (type === \"text\") addText(col);\n      if (type === \"image\") addImage(col);\n    });\n\n    columns.appendChild(col);\n  }\n\n  section.appendChild(columns);\n  canvas.appendChild(section);\n  updateMJML();\n}\n\n/* ===============================\n   TEXT BLOCK\n=============================== */\nfunction addText(col) {\n  const block = document.createElement(\"div\");\n  block.className = \"block\";\n\n  block.innerHTML = `\n    <button class=\"delete-btn\">✕</button>\n    <div contenteditable=\"true\">Edit text</div>\n  `;\n\n  block.querySelector(\"[contenteditable]\").addEventListener(\"input\", updateMJML);\n  block.querySelector(\".delete-btn\").addEventListener(\"click\", () => {\n    block.remove();\n    updateMJML();\n  });\n\n  col.appendChild(block);\n  updateMJML();\n}\n\n/* ===============================\n   IMAGE BLOCK\n=============================== */\nfunction addImage(col) {\n  const block = document.createElement(\"div\");\n  block.className = \"block\";\n\n  block.innerHTML = `\n    <button class=\"delete-btn\">✕</button>\n    <input type=\"file\" accept=\"image/*\"><br>\n    <img style=\"display:none\">\n    <div class=\"image-controls\">\n      Width <input type=\"range\" min=\"20\" max=\"100\" value=\"100\"> %\n    </div>\n  `;\n\n  const input = block.querySelector(\"input[type=file]\");\n  const img = block.querySelector(\"img\");\n  const range = block.querySelector(\"input[type=range]\");\n\n  block.querySelector(\".delete-btn\").addEventListener(\"click\", () => {\n    block.remove();\n    updateMJML();\n  });\n\n  input.addEventListener(\"change\", () => {\n    const reader = new FileReader();\n    reader.onload = e => {\n      img.src = e.target.result;\n      img.style.display = \"block\";\n      img.dataset.width = range.value;\n      updateMJML();\n    };\n    reader.readAsDataURL(input.files[0]);\n  });\n\n  range.addEventListener(\"input\", () => {\n    img.style.width = range.value + \"%\";\n    img.dataset.width = range.value;\n    updateMJML();\n  });\n\n  col.appendChild(block);\n  updateMJML();\n}\n\n/* ===============================\n   MJML GENERATOR\n=============================== */\nfunction updateMJML() {\n  let body = \"\";\n\n  document.querySelectorAll(\".section\").forEach(section => {\n    body += `<mj-section padding=\"10px\">`;\n\n    section.querySelectorAll(\".column\").forEach(col => {\n      body += `<mj-column>`;\n\n      col.querySelectorAll(\".block\").forEach(block => {\n        const text = block.querySelector(\"[contenteditable]\");\n        if (text) {\n          body += `<mj-text font-size=\"16px\" color=\"#333333\">${text.innerHTML}</mj-text>`;\n        }\n\n        const img = block.querySelector(\"img\");\n        if (img && img.src) {\n          body += `<mj-image src=\"${img.src}\" width=\"${img.dataset.width || 100}%\" padding=\"10px\"/>`;\n        }\n      });\n\n      body += `</mj-column>`;\n    });\n\n    body += `</mj-section>`;\n  });\n\n  mjmlOut.textContent = `<mjml><mj-body background-color=\"#f4f6fb\">${body}</mj-body></mjml>`;\n}\n\n/* ===============================\n   SAVE TEMPLATE (CSRF SAFE)\n=============================== */\ndocument.getElementById(\"save-template-btn\").addEventListener(\"click\", async () => {\n    const templateName = prompt(\"Enter Template Name:\");\n    if (!templateName) return alert(\"Template Name is required\");\n\n    let mjmlSource = mjmlOut.textContent; // raw MJML from builder\n\n    // 1️⃣ Find all base64 images in MJML and upload to Frappe\n    const base64Regex = /<mj-image[^>]+src=\"(data:image\\/[^\"]+)\"/g;\n    let match;\n    while ((match = base64Regex.exec(mjmlSource)) !== null) {\n        const base64 = match[1];\n\n        // Upload base64 image as Frappe File\n        const r = await frappe.call({\n            method: \"frappe.client.insert\",\n            args: {\n                doc: {\n                    doctype: \"File\",\n                    file_name: `image_${Date.now()}.jpg`,\n                    attached_to_doctype: \"Email Template\",\n                    attached_to_name: templateName,\n                    content: base64.split(\",\")[1], // remove \"data:image/jpeg;base64,\"\n                    decode: true\n                }\n            }\n        });\n\n        const file_url = r.message.file_url; // hosted file URL\n\n        // Replace base64 in MJML with hosted URL\n        mjmlSource = mjmlSource.replace(base64, file_url);\n    }\n\n    try {\n        // 2️⃣ Send MJML to backend to create template (backend compiles to HTML)\n        const response = await fetch(\"/api/method/legal_management.email_template.create_from_frontend\", {\n            method: \"POST\",\n            headers: {\n                \"Content-Type\": \"application/json\",\n                \"X-Frappe-CSRF-Token\": frappe.csrf_token\n            },\n            body: JSON.stringify({ template_name: templateName, mjml_source: mjmlSource })\n        });\n\n        const data = await response.json();\n        if (data.message) {\n            alert(`Email Template \"${templateName}\" created successfully!`);\n        } else {\n            alert(\"Failed to create template\");\n        }\n    } catch (err) {\n        console.error(err);\n        alert(\"Error connecting to server\");\n    }\n});\n\n// INITIAL MJML UPDATE\nupdateMJML();\n\n</script>\n\n</body>\n</html>\n",
  "main_section_md": "<!DOCTYPE html> <html lang=\"en\"> <head> <meta charset=\"UTF-8\" /> <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" /> <title>MJML Campaign Builder</title> <style> /* RESET */ * { box-sizing: border-box; } html, body { margin: 0; padding: 0; height: 100%; width: 100%; font-family: Inter, Arial, sans-serif; background: #f4f6fb; } /* ROOT LAYOUT */ .app { display: flex; flex-direction: column; height: 100vh; width: 100vw; } /* HEADER */ .header { height: 56px; background: #4a90e2; color: #fff; display: flex; align-items: center; padding: 0 20px; font-size: 18px; font-weight: 600; } /* MAIN */ .main { flex: 1; display: flex; overflow: hidden; } /* LEFT SIDEBAR */ .sidebar { width: 260px; background: #ffffff; border-right: 1px solid #ddd; padding: 14px; overflow-y: auto; } .sidebar h4 { margin-top: 0; margin-bottom: 10px; } .tool { background: #eef1f7; padding: 10px; margin-bottom: 10px; border-radius: 6px; text-align: center; cursor: grab; font-weight: 500; } /* CANVAS */ .canvas-wrapper { flex: 1; background: #eef1f7; padding: 20px; overflow-y: auto; } .canvas { max-width: 900px; margin: 0 auto; background: #ffffff; padding: 24px; border-radius: 8px; min-height: 100%; } /* SECTION / COLUMN */ .section { border: 2px dashed #ccc; padding: 14px; margin-bottom: 20px; } .columns { display: flex; gap: 12px; } .column { flex: 1; min-height: 120px; border: 1px dashed #aaa; padding: 10px; background: #fafafa; } /* BLOCKS */ .block { background: #ffffff; border: 1px solid #ddd; border-radius: 4px; padding: 8px; margin-bottom: 8px; position: relative; } .block [contenteditable]:focus { outline: 2px solid #4a90e2; } /* DELETE BUTTON */ .delete-btn { position: absolute; top: 4px; right: 4px; border: none; background: #ff4d4f; color: white; font-size: 12px; padding: 2px 6px; border-radius: 4px; cursor: pointer; } /* IMAGE */ .block img { max-width: 100%; display: block; margin-top: 6px; } .image-controls { font-size: 12px; margin-top: 6px; } /* RIGHT PANEL */ .right-panel { width: 420px; background: #ffffff; border-left: 1px solid #ddd; padding: 14px; overflow-y: auto; } .right-panel h4 { margin-top: 0; } pre { background: #f6f6f6; padding: 10px; border-radius: 6px; font-size: 12px; white-space: pre-wrap; word-break: break-word; } </style> </head> <body> <div class=\"app\"> <!-- HEADER --> <div class=\"header\"> MJML Campaign Builder </div> <!-- MAIN --> <div class=\"main\"> <!-- LEFT --> <div class=\"sidebar\"> <h4>Layout</h4> <div class=\"tool\" draggable=\"true\" data-type=\"1col\">1 Column</div> <div class=\"tool\" draggable=\"true\" data-type=\"2col\">2 Columns</div> <div class=\"tool\" draggable=\"true\" data-type=\"3col\">3 Columns</div> <hr> <h4>Blocks</h4> <div class=\"tool\" draggable=\"true\" data-type=\"text\">Text</div> <div class=\"tool\" draggable=\"true\" data-type=\"image\">Image</div> </div> <!-- CENTER --> <div class=\"canvas-wrapper\"> <div class=\"canvas\" id=\"canvas\"> <!-- Sections go here --> </div> </div> <!-- RIGHT --> <div class=\"right-panel\"> <h4>Generated MJML</h4> <pre id=\"mjmlOutput\"></pre> </div> </div> </div> <script> const canvas = document.getElementById(\"canvas\"); const mjmlOut = document.getElementById(\"mjmlOutput\"); /* =============================== DRAG SOURCES ================================ */ document.querySelectorAll(\".tool\").forEach(tool => { tool.addEventListener(\"dragstart\", e => { e.dataTransfer.setData(\"text/plain\", tool.dataset.type); }); }); /* =============================== CANVAS DROP (SECTIONS) ================================ */ canvas.addEventListener(\"dragover\", e => e.preventDefault()); canvas.addEventListener(\"drop\", e => { e.preventDefault(); const type = e.dataTransfer.getData(\"text/plain\"); if (type.endsWith(\"col\")) { addSection(parseInt(type[0])); } }); /* =============================== SECTION ================================ */ function addSection(colCount) { const section = document.createElement(\"div\"); section.className = \"section\"; const columns = document.createElement(\"div\"); columns.className = \"columns\"; for (let i = 0; i < colCount; i++) { const col = document.createElement(\"div\"); col.className = \"column\"; col.addEventListener(\"dragover\", e => e.preventDefault()); col.addEventListener(\"drop\", e => { e.preventDefault(); const type = e.dataTransfer.getData(\"text/plain\"); if (type === \"text\") addText(col); if (type === \"image\") addImage(col); }); columns.appendChild(col); } section.appendChild(columns); canvas.appendChild(section); updateMJML(); } /* =============================== TEXT BLOCK ================================ */ function addText(col) { const block = document.createElement(\"div\"); block.className = \"block\"; block.innerHTML = <button class=\"delete-btn\">✕</button> <div contenteditable=\"true\">Edit text</div> ; block.querySelector(\"[contenteditable]\").addEventListener(\"input\", updateMJML); block.querySelector(\".delete-btn\").addEventListener(\"click\", () => { block.remove(); updateMJML(); }); col.appendChild(block); updateMJML(); } /* =============================== IMAGE BLOCK ================================ */ function addImage(col) { const block = document.createElement(\"div\"); block.className = \"block\"; block.innerHTML = <button class=\"delete-btn\">✕</button> <input type=\"file\" accept=\"image/*\"><br> <img style=\"display:none\"> <div class=\"image-controls\"> Width <input type=\"range\" min=\"20\" max=\"100\" value=\"100\"> % </div> ; const input = block.querySelector(\"input[type=file]\"); const img = block.querySelector(\"img\"); const range = block.querySelector(\"input[type=range]\"); block.querySelector(\".delete-btn\").addEventListener(\"click\", () => { block.remove(); updateMJML(); }); input.addEventListener(\"change\", () => { const reader = new FileReader(); reader.onload = e => { img.src = e.target.result; img.style.display = \"block\"; img.dataset.width = range.value; updateMJML(); }; reader.readAsDataURL(input.files[0]); }); range.addEventListener(\"input\", () => { img.style.width = range.value + \"%\"; img.dataset.width = range.value; updateMJML(); }); col.appendChild(block); updateMJML(); } /* =============================== MJML GENERATOR ================================ */ function updateMJML() { let body = \"\"; document.querySelectorAll(\".section\").forEach(section => { body += <mj-section padding=\"10px\">; section.querySelectorAll(\".column\").forEach(col => { body += <mj-column>; col.querySelectorAll(\".block\").forEach(block => { // TEXT const text = block.querySelector(\"[contenteditable]\"); if (text) { body += <mj-text font-size=\"16px\" color=\"#333333\"> ${text.innerHTML} </mj-text>; } // IMAGE const img = block.querySelector(\"img\"); if (img && img.src) { body += <mj-image src=\"${img.src}\" width=\"${img.dataset.width || 100}%\" padding=\"10px\" />; } }); body += </mj-column>; }); body += </mj-section>; }); mjmlOut.textContent = <mjml> <mj-body background-color=\"#f4f6fb\"> ${body} </mj-body> </mjml>; } </script> </body> </html>",
