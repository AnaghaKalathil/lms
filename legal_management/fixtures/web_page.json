  "main_section_html": "<div class=\"container py-5\">\n    <div class=\"row justify-content-center\">\n        <div class=\"col-md-7 col-lg-6\">\n\n            <div class=\"card shadow-lg border-0\">\n                <div class=\"card-body p-4 p-md-5\">\n\n                    <!-- Header -->\n                    <div class=\"text-center mb-4\">\n                        <h3 class=\"fw-bold\">Legal Management System</h3>\n                        <p class=\"text-muted mb-0\">\n                            Create your client account\n                        </p>\n                    </div>\n\n                    <!-- Registration Form -->\n                    <form id=\"client-form\">\n\n                        <div class=\"mb-3\">\n                            <label class=\"form-label\">Full Name</label>\n                            <input type=\"text\" class=\"form-control\"\n                                   name=\"full_name\"\n                                   placeholder=\"Enter your full name\"\n                                   required>\n                        </div>\n\n                        <div class=\"mb-3\">\n                            <label class=\"form-label\">Email Address</label>\n                            <input type=\"email\" class=\"form-control\"\n                                   name=\"email\"\n                                   placeholder=\"you@example.com\"\n                                   required>\n                        </div>\n\n                        <div class=\"mb-3\">\n                            <label class=\"form-label\">Mobile Number</label>\n                            <input type=\"text\" class=\"form-control\"\n                                   name=\"mobile\"\n                                   placeholder=\"10-digit mobile number\"\n                                   required>\n                        </div>\n\n                        <div class=\"mb-4\">\n                            <label class=\"form-label\">Password</label>\n                            <input type=\"password\" class=\"form-control\"\n                                   name=\"password\"\n                                   placeholder=\"Create a strong password\"\n                                   required>\n                        </div>\n\n                        <div class=\"d-grid\">\n                            <button type=\"submit\"\n                                    class=\"btn btn-primary btn-lg\">\n                                Register & Continue\n                            </button>\n                        </div>\n\n                    </form>\n\n                    <!-- Footer -->\n                    <div class=\"text-center mt-4\">\n                        <small class=\"text-muted\">\n                            Are you a lawyer?\n                            <a href=\"/login\" class=\"fw-semibold\">\n                                Login here\n                            </a>\n                        </small>\n                    </div>\n\n                </div>\n            </div>\n\n            <!-- Trust note -->\n            <div class=\"text-center mt-3\">\n                <small class=\"text-muted\">\n                    Your information is kept confidential & secure\n                </small>\n            </div>\n\n        </div>\n    </div>\n</div>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n\n    const form = document.getElementById(\"client-form\");\n\n    form.addEventListener(\"submit\", function(e) {\n        e.preventDefault();\n\n        const btn = form.querySelector(\"button\");\n        btn.disabled = true;\n        btn.innerText = \"Creating account...\";\n\n        fetch(\"/api/method/legal_management.api.register_customer\", {\n            method: \"POST\",\n            headers: {\n                \"Content-Type\": \"application/json\",\n                \"X-Frappe-CSRF-Token\": frappe.csrf_token\n            },\n            body: JSON.stringify({\n                full_name: form.full_name.value,\n                email: form.email.value,\n                mobile: form.mobile.value,\n                password: form.password.value\n            })\n        })\n        .then(r => r.json())\n        .then(r => {\n            console.log(\"API response:\", r);\n\n            if (r.message && r.message.status === \"success\") {\n                window.location.href = \"/app/customer-dashboard\";\n            } else {\n                alert(r.exc || \"Registration failed\");\n                btn.disabled = false;\n                btn.innerText = \"Register & Continue\";\n            }\n        })\n        .catch(err => {\n            console.error(err);\n            alert(\"Something went wrong\");\n            btn.disabled = false;\n            btn.innerText = \"Register & Continue\";\n        });\n    });\n\n});\n</script>\n\n",
