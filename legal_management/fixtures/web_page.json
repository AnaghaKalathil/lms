  "main_section_html": "<div class=\"container text-center mt-5\">\n    <h2>Legal Management System</h2>\n    <p>Please choose how you want to login</p>\n\n    <div class=\"mt-6\">\n        <a href=\"/customer-register\" class=\"btn btn-primary btn-lg m-2\">\n            Register as User\n        </a>\n        <a href=\"/login\" class=\"btn btn-primary btn-lg m-2\">\n            Login as User\n        </a>\n\n        <a href=\"/login\" class=\"btn btn-primary btn-lg m-2\">\n            Login as Lawyer\n        </a>\n    </div>\n</div>\n",
